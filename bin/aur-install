#!/usr/bin/env bash
# fzf picker over every AUR package: fuzzy-search by name, `yay -Sii` in
# the pane below, <tab> to pick several, <enter> hands the picks to
# `yay -S`. Conf › Install › AUR opens this in a terminal (after
# omarchy's pkg-aur-install); the App manager's AUR chip is still there
# for searching by description.
set -euo pipefail

# PKGBUILD view: `yay -Gp` prints two blank lines and a "# pkgname" header
# before the file itself, hence the tail. Plain text without bat.
pkgbuild='yay -Gpa {1} 2>/dev/null | tail -n +5'
command -v bat >/dev/null && pkgbuild+=' | bat -l bash -p --color=always'
info='yay -Siia {1} 2>/dev/null'

picks=$(
	yay -Slqa | fzf \
		--multi \
		--prompt '> ' \
		--pointer '▌' --gutter ' ' \
		--color 'pointer:green,marker:green,prompt:blue,label:dim' \
		--preview "$info" \
		--preview-window 'down:65%:wrap:border-rounded' \
		--preview-label 'alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll, tab: multi-select' \
		--preview-label-pos bottom \
		--bind 'alt-p:toggle-preview' \
		--bind "alt-b:change-preview($pkgbuild)" \
		--bind "alt-B:change-preview($info)" \
		--bind 'alt-j:preview-down,alt-k:preview-up' \
		--bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
) || exit 0

# One package per line from fzf; yay's own review/confirm prompts stay on.
mapfile -t pkgs <<<"$picks"
status=0
yay -S --needed "${pkgs[@]}" || status=$?

# Held here rather than by the terminal (Terminal.run's `hold`), so that
# Esc out of the picker closes the window without a "press Enter".
printf '\n\033[2m— finished (exit %s) · press Enter to close —\033[0m\n' "$status"
read -r _
exit "$status"
