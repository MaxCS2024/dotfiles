#!/usr/bin/env bash
# Runs tests/bar/shell.qml against the real bar/Bar.qml.
#
# Bar.qml is a Variants of PanelWindows, so it needs a live Quickshell (and
# Hyprland, for Quickshell.Hyprland) rather than qmltestrunner. It also
# imports its services by relative path ("../services"), so the only way to
# hand it stubs is to put it in a tree where "../services" is the stubs:
# this copies tests/bar/ and the two real bar files into a temp dir and
# runs that with `qs -p`.
#
# While it runs, a transparent test bar briefly reserves a strip on each
# screen for the show/hide tests; tiled windows shift and shift back.
#
# Exits 0 when every check passes, 1 on any failure, 2 if the run never
# finished (a QML error before the tests started, or a hang).

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
main="$(dirname "$here")"
sandbox="$(mktemp -d)"
log="$sandbox/qs.log"
qs_pid=

cleanup() {
    [[ -n "$qs_pid" ]] && kill "$qs_pid" 2>/dev/null || true
    rm -rf "$sandbox"
}
trap cleanup EXIT

cp -r "$here/bar/." "$sandbox/"
cp "$main/bar/Bar.qml" "$main/bar/BarModuleLoader.qml" "$sandbox/bar/"

qs -p "$sandbox" --no-color >"$log" 2>&1 &
qs_pid=$!

# qs ignores Qt.quit(), so wait for the test's own last line instead.
for _ in $(seq 1 150); do
    grep -q 'BARTEST DONE' "$log" && break
    kill -0 "$qs_pid" 2>/dev/null || break
    sleep 0.1
done

grep -o 'BARTEST .*' "$log" | sed 's/^BARTEST //' | grep -v '^DONE' || true

if ! grep -q 'BARTEST DONE' "$log"; then
    echo "run did not finish; qs log:" >&2
    cat "$log" >&2
    exit 2
fi

# Any QML warning from Bar.qml itself is worth seeing even when checks pass.
grep -E 'WARN|ERROR' "$log" | grep -v 'no receivers connected' >&2 || true

failures="$(grep -o 'BARTEST DONE [0-9]*' "$log" | awk '{print $3}')"
echo "$failures failed"
[[ "$failures" == 0 ]]
