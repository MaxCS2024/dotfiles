# Two generated colour sources, the same pair foot.ini includes and in the
# same order — where both set a key, the later one wins:
#
#   ~/.cache/matugen/ghostty-colors       the wallpaper palette, written by
#     matugen. See matugen/config.toml and templates/ghostty-colors.
#
#   ~/.cache/quickshell/ghostty-theme     the named theme picked under
#     Appearance in quickshell's settings, written by
#     quickshell/main/theme/TerminalTheme.qml. Holds nothing but comments
#     while Appearance follows the wallpaper, which leaves matugen's
#     colours above standing.
#
# The leading ? makes each optional: either is missing until whatever
# writes it has run once. Running ghostties pick a change up without a
# restart — both writers send SIGUSR2 after writing, which makes ghostty
# reload its configuration.
config-file = ?~/.cache/matugen/ghostty-colors
config-file = ?~/.cache/quickshell/ghostty-theme
