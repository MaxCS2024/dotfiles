# Patch: Apple SuperDrive
# Needs: sg3_utils
# Trigger: --subsystem-match=block --sysname-match=sr*
#
# Apple USB SuperDrive (05ac:1500) rejects every disc until the host sends
# Apple's vendor wake-up command; macOS does it, Linux doesn't. Send it
# whenever the drive appears (plug-in, boot, or a USB reset).
ACTION=="add", SUBSYSTEM=="block", KERNEL=="sr[0-9]*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1500", RUN+="/usr/bin/sg_raw /dev/%k EA 00 00 00 00 00 01"
